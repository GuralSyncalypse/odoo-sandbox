# Public URL of this Website. Do not prefix server values with NEXT_PUBLIC_.
TELESALES_WEBSITE_URL=http://localhost:3000
TELESALES_ODOO_BASE_URL=http://localhost:8069
TELESALES_JWT_ISSUER=website
TELESALES_JWT_AUDIENCE=odoo
TELESALES_JWT_TTL_SECONDS=900

# Use \n escapes when providing PEM in a single environment variable.
# This private key stays on the Website server. Set the matching public key in
# Odoo parameter telesales_data_allocation.jwt_public_key.
TELESALES_JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"

# Comma-separated, normalised phone/email identifiers. Odoo still independently
# checks telesales.api.account.is_admin before accepting an Admin endpoint call.
TELESALES_ADMIN_SUBJECTS=admin@example.com

# Public display values for the manual top-up screen. Do not put callback
# credentials or other secrets here.
TELESALES_VIETQR_IMAGE_URL=https://img.vietqr.io/image/VCB-1027298655-compact.svg
TELESALES_BANK_INSTRUCTIONS=Transfer the exact VND amount and include the order ID in the transfer note.
